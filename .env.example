# Shared Bearer token between relay (/ws) and processor
RELAY_APIKEY=

# Relay
ROOT_PATH=/

# Processor — PGVector (OpenAI embeddings)
PGVECTOR_CONN=postgres://user:password@localhost:5432/ragkit?sslmode=disable
PGVECTOR_TABLE_PHRASES=homin_dev_phrases_openai

OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_APIKEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Genkit / Gemini (pre-process flow)
GEMINI_API_KEY=
