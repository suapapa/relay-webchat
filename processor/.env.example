# Relay WebSocket endpoint & shared Bearer token
RELAY_WS=wss://homin.dev/webchat-relay/ws
RELAY_APIKEY=

# PGVector (OpenAI embeddings)
PGVECTOR_CONN=postgres://user:password@localhost:5432/ragkit?sslmode=disable
PGVECTOR_TABLE_PHRASES=homin_dev_phrases_openai

# OpenAI-compatible API (embeddings & chat)
OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_APIKEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
# Must match model output and pgvector column (text-embedding-3-small=1536; many local embeds=768)
OPENAI_EMBED_DIM=1536
OPENAI_CHAT_MODEL=gpt-4o-mini
