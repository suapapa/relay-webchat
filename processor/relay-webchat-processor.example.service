[Unit]
Description=Relay WebChat Processor Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/relay-webchat
# ExecStart=/opt/relay-webchat/processor_arm64 -ws wss://homin.dev/webchat-relay/ws -pre-process -retrive 10
Environment=RELAY_APIKEY={YOUR_RELAY_APIKEY}
Environment=PGVECTOR_CONN=postgres://user:password@192.168.219.153:5432/ragkit?sslmode=disable
Environment=PGVECTOR_TABLE_PHRASES=homin_dev_phrases_openai
Environment=OPENAI_ENDPOINT=https://api.openai.com/v1
Environment=OPENAI_APIKEY={YOUR_OPENAI_APIKEY}
Environment=OPENAI_EMBED_MODEL=text-embedding-3-small
Environment=GEMINI_API_KEY={YOUR_GEMINI_API_KEY}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
