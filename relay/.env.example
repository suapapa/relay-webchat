# Shared Bearer token between relay (/ws) and processor
RELAY_APIKEY=

# Relay
ROOT_PATH=/

# CORS allowed origins (comma-separated, default: https://homin.dev,https://www.homin.dev,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000, use * to allow all)
ALLOWED_ORIGINS=https://homin.dev,https://www.homin.dev,http://localhost:5173,http://localhost:3000

# Rate limiting for /chat per IP (requests per minute, default: 10, set 0 to disable)
RATE_LIMIT_RPM=10
# Rate limit burst capacity (default: 5)
RATE_LIMIT_BURST=5
